---
// A panel glyph (Glyph in ../../../src/art.tsx), for the mock of the app.
import { FRONT, FRONT_LINES, GLYPH_MARKS } from "../../../src/art-paths";
interface Props { mark: keyof typeof GLYPH_MARKS; base?: "page" | "window"; size?: number }
const { mark, base = "page", size = 64 } = Astro.props;
const { d, tone } = GLYPH_MARKS[mark];
---
<svg class="glyph" viewBox="18 14 84 84" width={size} height={size} aria-hidden="true">
  {base === "page" ? (
    <><path class="page" d={FRONT} /><path class="line" d={FRONT_LINES} /></>
  ) : (
    <><rect class="page" x="22" y="24" width="62" height="54" /><path class="line" d="M34 42L43 50L34 58M49 60H62" /></>
  )}
  <path class="mark-cut" d={d} />
  <path class={`mark ${tone}`} d={d} />
</svg>
