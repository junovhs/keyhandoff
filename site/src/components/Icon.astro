---
// The site's line icons, all from Lucide, by the names the pages already use.
import {
  ArrowDown, ArrowRight, ArrowUpRight, BookOpen, Bot, Bug, Check, CircleAlert, Clipboard, Clock, Cloud, Cpu,
  EyeOff, File, Flame, Keyboard, KeyRound, Lock, MessageSquare, Package, Puzzle, Search, ServerOff, ShieldCheck,
  SquareTerminal, User, Users,
} from "@lucide/astro";

const ICONS = {
  check: Check,
  key: KeyRound,
  shield: ShieldCheck,
  file: File,
  search: Search,
  down: ArrowDown,
  right: ArrowRight,
  out: ArrowUpRight,
  bot: Bot,
  package: Package,
  plugin: Puzzle,
  bug: Bug,
  user: User,
  users: Users,
  cloud: Cloud,
  lock: Lock,
  eyeoff: EyeOff,
  clip: Clipboard,
  clock: Clock,
  terminal: SquareTerminal,
  chat: MessageSquare,
  chip: Cpu,
  offline: ServerOff,
  book: BookOpen,
  type: Keyboard,
  alert: CircleAlert,
  flame: Flame,
} as const;

export type IconName = keyof typeof ICONS;

interface Props { name: IconName; size?: number }
const { name, size = 16 } = Astro.props;
const Lucide = ICONS[name];
---
<Lucide class="icon" size={size} aria-hidden="true" />
