---
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import type { IconName } from "../components/Icon.astro";
import StrangeGlyph from "../components/StrangeGlyph.astro";
import Tile from "../components/Tile.astro";
import AppIcon from "../components/AppIcon.astro";
import AppPages from "../components/AppPages.astro";
import AppGlyph from "../components/AppGlyph.astro";
import { ArrowUpRight, Clipboard, Crown, Folder, Mail, MessageSquare, FileInput, FolderOpen, IdCard, KeyRound, Plus, Search, Send, Settings, SquareTerminal, UserRound, Vault } from "@lucide/astro";
import appCss from "../../../src/styles.css?raw";
import { scopeAppCss } from "../lib/app-css.mjs";
import { getLatestRelease, formatSize, ALL_RELEASES } from "../lib/releases.mjs";

const title = "KeyHandoff: the open source secrets manager";
const description = "The free, open source secrets manager. Save, use and share API keys without anyone ever seeing them. Programs and AI agents use keys without holding them, and KeyHandoff asks you before an agent gets one. No servers, no accounts.";
const GITHUB = "https://github.com/junovhs/keyhandoff";
// Null until the first release; then the end of the page offers its installers.
const release = await getLatestRelease();

const MAKER = "https://strangesystems.dev";
// The team section's opening and closing frames, shown a word at a time.
const INTRO = "Watch Ben send Ann a key without it ever touching the chat.";
const OUTRO = "It works over Slack, Teams, email or anything else you already use.";
// Ben's and Ann's windows are drawn with the app's own stylesheet.
const APP_CSS = scopeAppCss(appCss);

// The footer only links pages that exist on this site or in the repository.
const FOOTER: { title: string; links: [string, string][] }[] = [
  { title: "Learn", links: [["User manual", "/docs/"], ["Developer reference", "/docs/reference/"], ["Articles", "/articles/"]] },
  { title: "Project", links: [["GitHub", GITHUB], ["Releases", ALL_RELEASES], ["Report a vulnerability", `${GITHUB}/security`]] },
];


// What each reader gets from a plain .env, and from one that holds pointers.
const READERS: { icon: IconName; name: string; how: string; gets: string; safe: string }[] = [
  { icon: "bot", name: "AI assistants", how: "Read your project files.", gets: "Can paste your key into a prompt.", safe: "Can only paste a useless pointer." },
  { icon: "package", name: "A poisoned package", how: "Runs as you on install.", gets: "Uploads your key in seconds.", safe: "Uploads a useless pointer." },
  { icon: "plugin", name: "A rogue extension", how: "Sees your whole workspace.", gets: "Can send your key anywhere.", safe: "Can only send a pointer." },
  { icon: "bug", name: "An infostealer", how: "Hunts for this filename.", gets: "Can sell your key to whoever's buying.", safe: "Has nothing worth selling." },
  { icon: "user", name: "Someone in your session", how: "One search is all it takes.", gets: "Copies your key in one go.", safe: "Copies a pointer, not a key." },
  { icon: "cloud", name: "Backup and sync", how: "Copies the file off your machine.", gets: "Puts your key in every copy.", safe: "Puts a pointer in every copy." },
];

const INCIDENTS = [
  { when: "Aug 2025", name: "Nx", text: "Poisoned releases hunted for .env files.", source: "StepSecurity", href: "https://www.stepsecurity.io/blog/supply-chain-security-alert-popular-nx-build-system-package-compromised-with-data-stealing-malware" },
  { when: "Sep 2025", name: "Shai-Hulud", text: "A worm that stole tokens to spread itself.", source: "Varonis", href: "https://www.varonis.com/blog/shai-hulud-campaigns" },
  { when: "May 2026", name: "node-ipc", text: "Its target list: .env.local, .env.production.", source: "Semgrep", href: "https://semgrep.dev/blog/2026/not-your-ipc-but-node-ipc-npm-hit-again-with-supply-chain-attack-but-this-time-its-not-a-worm" },
];

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://keyhandoff.dev/" />
    <meta name="theme-color" content="#000000" />
    <style is:inline set:html={APP_CSS}></style>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://keyhandoff.dev/" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <nav class="nav">
      <div class="wrap nav-in">
        <div class="lockup">
          <a class="lockup-mark" href="/" aria-label="KeyHandoff home"><Logo height={62} /></a>
          <div class="lockup-words">
            <a class="lockup-name" href="/">KeyHandoff</a>
            <a class="byline" href={MAKER}>by strange systems</a>
          </div>
        </div>
        <span class="sp"></span>
        <a class="l hide-s" href="#blind-spot">Why</a>
        <a class="l hide-s" href="#solo">A key&rsquo;s life</a>
        <a class="l" href="#download">Download</a>
        <a class="l" href="/docs/">Docs</a>
        <a class="l hide-s" href="/docs/reference/">Reference</a>
        <a class="btn secondary small" href={GITHUB}><svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg><span class="hide-xs">GitHub</span></a>
      </div>
    </nav>

    <header class="wrap hero">
      <div class="hero-copy">
                <h1 class="hero-title">The open source <br /><span class="pearl-text">secrets manager.</span></h1>
        <ul class="points" data-points>
          <li><Icon name="key" size={22} />Save, use and share keys safely.</li>
          <li><Icon name="terminal" size={22} />Your programs never hold the real key.</li>
          <li><Icon name="bot" size={22} />AI agents have to ask you first.</li>
        </ul>
        <div class="cta">
          <a class="btn primary" href="#download"><Icon name="down" />Download</a>
          <a class="btn secondary" href={GITHUB}>See the code <Icon name="out" /></a>
        </div>
      </div>

      <!-- The real vault window, drawn with the app's own stylesheet (.kh). It reads
           as it stands; scripts/hero.ts then has a cursor work it through each
           bullet: save a key, send one, a program asks, an AI agent asks. -->
      <div class="hero-app" data-hero-app aria-hidden="true">
        <div class="kh hero-win">
          <div class="app">
            <header class="titlebar">
              <button class="brand" tabindex="-1"><svg class="logo" viewBox="28 8 64 104" height="22" width="13.5"><path fill-rule="evenodd" fill="currentColor" d="M28 8H92V60H72V78H90V90H72V98H90V112H48V60H28ZM50 24V44H70V24Z" /></svg></button>
              <span class="name">KeyHandoff</span>
            </header>
            <main class="stage">
              <div class="vault-heading">
                <svg class="vault-mark" data-hv-shield viewBox="0 0 32 32" width="34" height="34"><defs><linearGradient id="hero-vault-pearl" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ddd5ff" /><stop offset=".4" stop-color="#c4ece6" /><stop offset=".75" stop-color="#f4d4e8" /><stop offset="1" stop-color="#d3cdff" /></linearGradient></defs><path d="M16 3.5 26 7.25v7.6c0 6.4-4.2 11.3-10 13.65C10.2 26.15 6 21.25 6 14.85v-7.6Z" fill="none" stroke="url(#hero-vault-pearl)" stroke-width="1.7" stroke-linejoin="round" /><circle cx="16" cy="14.25" r="2.4" fill="#f2f0fa" /></svg>
                <div><h1 class="display sm">Your secure keys</h1><p class="lede">4 keys sealed on this machine</p></div>
              </div>
              <div class="btn-row vault-actions">
                <button class="btn primary grow add" data-hv-add tabindex="-1"><Plus size={17} />Add a key</button>
                <button class="btn secondary grow" data-hv-send tabindex="-1"><Send size={16} />Send a key</button>
              </div>
              <div class="tools-row">
                <button class="quiet" tabindex="-1"><FolderOpen size={15} />Open file</button>
                <button class="quiet" tabindex="-1"><FileInput size={15} strokeWidth={1.75} />Import .env</button>
                <button class="quiet" tabindex="-1"><SquareTerminal size={15} strokeWidth={1.75} />Use in code</button>
              </div>
              <div class="vault">
                <div class="search"><Search size={17} /><input type="search" placeholder="Search 4 keys" tabindex="-1" disabled /></div>
                <div class="key-ledger">
              <div class="ledger-row fresh"><span class="ledger-key"><KeyRound size={15} /></span><span class="ledger-text"><span class="ledger-name mono">STRIPE_SECRET_KEY</span><span class="ledger-meta">Yours · Kept · api.stripe.com</span></span></div>
              <div class="ledger-row"><span class="ledger-key"><KeyRound size={15} /></span><span class="ledger-text"><span class="ledger-name mono">OPENAI_API_KEY</span><span class="ledger-meta">Yours · Kept · api.openai.com</span></span></div>
              <div class="ledger-row"><span class="ledger-key"><KeyRound size={15} /></span><span class="ledger-text"><span class="ledger-name mono">GITHUB_TOKEN</span><span class="ledger-meta">Yours · 12 days left · api.github.com</span></span></div>
              <div class="ledger-row"><span class="ledger-key"><KeyRound size={15} /></span><span class="ledger-text"><span class="ledger-name mono">DATABASE_URL</span><span class="ledger-meta">From Ann · Kept</span></span></div>
                </div>
              </div>
              <footer class="identity-dock">
                <button class="pocket-card" tabindex="-1"><IdCard /><span>Share my card<small>.handoff file</small></span><ArrowUpRight size={14} /></button>
                <strong class="dock-name">Ben</strong>
                <button class="dock-settings" tabindex="-1"><Settings /></button>
              </footer>
            </main>
            <div class="safe hv hv-copy">
              <div class="top"><AppIcon name="shield" /><b>Safe Copy</b></div>
              <div class="safe-body"><div class="safe-stage"><AppPages mark="none" /><h2 class="display">Copy your key</h2><p class="sub">From anywhere · 42s</p></div></div>
            </div>
            <div class="safe hv hv-caught">
              <div class="top"><AppIcon name="shield" /><b>Safe Copy</b></div>
              <div class="safe-body">
                <div class="safe-stage"><AppPages mark="check" /><h2 class="display">Caught</h2><p class="sub">Clipboard wiped.</p></div>
                <div class="below">
                  <span class="name-in">STRIPE_SECRET_KEY</span>
                  <div class="keep-buttons"><button tabindex="-1"><AppIcon name="once" />Use once</button><button tabindex="-1"><AppIcon name="calendar" />Keep 30 days</button><button tabindex="-1" data-hv-keep><AppIcon name="forever" />Keep forever</button></div>
                </div>
              </div>
            </div>
            <div class="safe sealed hv hv-sealed">
              <div class="top"><AppIcon name="shield" /><b>Send a key</b><span>for Ann</span></div>
              <div class="safe-body">
                <div class="safe-stage">
                  <div class="card-file key-card" data-hv-file><span class="key-card-mark"><IdCard size={30} strokeWidth={1.5} /><KeyRound size={15} strokeWidth={2.2} /></span><span><strong>Key for Ann</strong><small>Key for Ann.handoff</small></span></div>
                  <h2 class="display">Sealed</h2><p class="sub">Only Ann&rsquo;s computer can open it.</p>
                </div>
                <div class="below"><button class="btn primary" tabindex="-1" data-hv-copyfile>Copy as text</button><p class="help center">Drag the card into a chat, an email or a folder.</p></div>
              </div>
            </div>
            <div class="sheet hv hv-program">
              <div class="head"><AppGlyph mark="key" size={52} /><div><span class="lede">A program wants a key</span><h2 class="display md">server.js</h2></div></div>
              <div class="facts">
                <div class="fact"><SquareTerminal size={17} strokeWidth={1.75} /><span class="mono">node server.js</span></div>
                <div class="fact"><FolderOpen size={17} strokeWidth={1.75} /><span class="mono">~/code/shop</span></div>
                <div class="fact on"><KeyRound size={17} strokeWidth={1.75} /><span>STRIPE_SECRET_KEY</span></div>
              </div>
              <p class="help">It gets a stand-in. The real key goes straight to api.stripe.com.</p>
              <span class="grow-space"></span>
              <div class="btn-row"><button class="btn secondary" tabindex="-1">Deny</button><button class="btn secondary" tabindex="-1">Allow once</button><button class="btn primary grow" tabindex="-1" data-hv-always>Always allow</button></div>
            </div>
            <div class="sheet hv hv-agent">
              <div class="head"><AppGlyph mark="key" size={52} /><div><span class="lede">Claude Code wants a key</span><h2 class="display md">npm run dev</h2></div></div>
              <div class="facts">
                <div class="fact"><SquareTerminal size={17} strokeWidth={1.75} /><span class="mono">npm run dev</span></div>
                <div class="fact"><FolderOpen size={17} strokeWidth={1.75} /><span class="mono">~/code/shop</span></div>
                <div class="fact on"><KeyRound size={17} strokeWidth={1.75} /><span>OPENAI_API_KEY</span></div>
              </div>
              <p class="help">Nothing runs with your key until you answer.</p>
              <span class="grow-space"></span>
              <div class="btn-row"><button class="btn secondary" tabindex="-1">Deny</button><button class="btn secondary" tabindex="-1">Allow once</button><button class="btn primary grow" tabindex="-1" data-hv-session>Allow for 30 minutes</button></div>
            </div>
          </div>
        </div>
        <!-- Where a sealed key can go: drag it into a chat or an email, save it to a
             folder, or copy it as text. The cursor uses a different one each loop. -->
        <ul class="hv-tray">
          <li data-hv-to="chat"><MessageSquare size={20} /><span>Teams or Slack</span></li>
          <li data-hv-to="mail"><Mail size={20} /><span>Email</span></li>
          <li data-hv-to="folder"><Folder size={20} /><span>A folder</span></li>
          <li data-hv-to="clip"><Clipboard size={20} /><span>Copy as text</span></li>
        </ul>
        <span class="hv-ghost card-file key-card"><span class="key-card-mark"><IdCard size={24} strokeWidth={1.5} /><KeyRound size={12} strokeWidth={2.2} /></span><span><strong>Key for Ann</strong></span></span>
        <svg class="hv-cursor" viewBox="0 0 16 22" width="26" height="36"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
      </div>

      <ul class="trust">
        <li><Icon name="offline" size={26} />No servers or accounts</li>
        <li><Icon name="eyeoff" size={26} />Keys never shown</li>
        <li><Icon name="book" size={26} />Free, public source</li>
        <li><Icon name="users" size={26} />Built in public</li>
      </ul>
    </header>

    <section class="wrap" id="blind-spot">
      <h2 class="big-q rv">29 million new secrets turned up in public code in 2025. <br /><em>Every one was handled by a person or a tool.</em></h2>
      <p class="stat-source rv">Source: <a href="https://www.gitguardian.com/state-of-secrets-sprawl-report-2026">GitGuardian, The State of Secrets Sprawl 2026</a></p>
      <!-- The key's birth: made on the provider's page, caught by Safe Copy the moment
           it's copied. The whole picture is there at once; keypath.ts brings the key
           to life at [data-born-at] and the cursor's click only plays over it. -->
      <div class="birthplace" data-born aria-hidden="true">
        <div class="sc-card bp-provider">
          <span class="sc-card-top">Stripe · API keys</span>
          <span class="bp-made"><Icon name="check" size={14} />New secret key created</span>
          <span class="bp-val"><code>sk_live_51Nq8vTz<span>••••••••••••</span></code></span>
          <span class="btn primary small bp-copy">Copy</span>
          <svg class="gen-cursor" viewBox="0 0 16 22" width="30" height="40"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
        </div>
        <span class="bp-flow"></span>
        <span class="born-at" data-born-at><span class="halo"></span></span>
        <div class="kh bp-safe">
          <div class="app">
            <div class="safe caught">
              <div class="top"><AppIcon name="shield" /><b>Safe Copy</b></div>
              <div class="safe-body">
                <div class="safe-stage"><AppPages mark="check" /><h2 class="display">Caught</h2><p class="sub">Clipboard wiped.</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="proof-line rv">This keeps happening. Look up {INCIDENTS.map((n, i) => <>{i ? (i === INCIDENTS.length - 1 ? " and " : ", ") : ""}<a href={n.href}>{n.name}</a></>)}.</p>
    </section>

    <section class="wrap" id="solo">
      <div class="head rv">
        <span class="eyebrow"><Icon name="key" />1 · Save it</span>
        <h2>Copy it once. It&rsquo;s caught, sealed, and gone from your clipboard.</h2>
      </div>
      <div class="scene sc-save" data-scene="save" data-step="0">
        <div class="sc-card sc-provider">
          <span class="sc-card-top">Stripe · API keys</span>
          <span class="sc-label">Secret key</span>
          <span class="sc-slot"></span>
          <span class="btn primary small sc-copy">Copy</span>
        </div>
        <div class="sc-clip"><Icon name="clip" size={18} /><span class="full">Clipboard</span><span class="wiped"><Icon name="check" size={14} />Wiped</span></div>
        <div class="sc-vault"><span class="lid"></span><span class="box"><Logo height={26} /></span><span class="sc-vault-name">Your vault</span></div>
        <svg class="cursor sc-cursor" viewBox="0 0 16 22" width="22" height="30" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
      </div>
    </section>

    <section class="wrap" id="code">
      <div class="head rv">
        <span class="eyebrow"><Icon name="terminal" />2 · Use it</span>
        <h2>Your code gets the key only when you say so.</h2>
      </div>
      <div class="scene sc-use" data-scene="use" data-step="0">
        <div class="sc-card sc-prog">
          <span class="sc-card-top"><Icon name="terminal" size={15} />report.py</span>
          <code class="sc-env">STRIPE_KEY=</code>
          <span class="sc-slot"></span>
          <span class="sc-run"><i></i>running</span>
        </div>
        <div class="sc-mini-vault"><Logo height={20} /></div>
        <div class="prompt sc-prompt">
          <div class="prompt-top"><span class="tile sm"><Logo height={21} /></span><b>KeyHandoff</b><span>A program is asking</span></div>
          <p class="prompt-q"><code>report.py</code> wants the <b>Stripe</b> key</p>
          <p class="prompt-where"><Icon name="file" size={14} />~/work/report-bot</p>
          <div class="prompt-btns"><span class="btn secondary small">Just once</span><span class="btn primary small sc-allow">Always allow</span></div>
        </div>
        <svg class="cursor sc-cursor" viewBox="0 0 16 22" width="22" height="30" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
      </div>
    </section>

    <section class="wrap" id="standin">
      <div class="head rv">
        <span class="eyebrow"><Icon name="shield" />Stand-ins</span>
        <h2>Your program holds a stand-in. The real key only travels encrypted.</h2>
      </div>
      <div class="scene sc-standin" data-scene="standin" data-step="0">
        <div class="sc-card sc-prog">
          <span class="sc-card-top"><Icon name="terminal" size={15} />report.py</span>
          <code class="sc-env">STRIPE_KEY=</code>
          <span class="sc-slot"><span class="sc-ghost"></span></span>
          <span class="sc-tag">stand-in</span>
        </div>
        <span class="sc-tunnel"><Icon name="lock" size={16} /></span>
        <div class="sc-card sc-server"><span class="sc-card-top"><Icon name="check" size={15} />api.stripe.com</span><span class="sc-got">Got the real key</span></div>
      </div>
      <p class="limits rv"><a href="/docs/keyhandoff-run/">How stand-ins work</a></p>
    </section>

    <section class="wrap" id="agents">
      <div class="head rv">
        <span class="eyebrow"><Icon name="bot" />3 · AI agents</span>
        <h2>An AI agent asks for the key. KeyHandoff asks you.</h2>
      </div>
      <div class="scene sc-agent" data-scene="agent" data-step="0">
        <div class="sc-card sc-bot"><Icon name="bot" size={30} /><b>Claude Code</b><span class="sc-session">This session</span></div>
        <span class="sc-reach"></span>
        <span class="sc-gate"></span>
        <div class="prompt sc-prompt">
          <div class="prompt-top"><span class="tile sm"><Logo height={21} /></span><b>KeyHandoff</b><span>An AI agent is asking</span></div>
          <p class="prompt-q"><b>Claude Code</b> wants the <b>Stripe</b> key</p>
          <div class="prompt-btns"><span class="btn secondary small">Not now</span><span class="btn primary small sc-allow">Allow this session</span></div>
        </div>
        <span class="sc-revoke">Revoke</span>
        <svg class="cursor sc-cursor" viewBox="0 0 16 22" width="22" height="30" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
      </div>
    </section>

    <section class="wrap" id="team">
      <div class="head rv">
        <span class="eyebrow"><Icon name="users" />4 · Share it</span>
        <h2>Sealed for one person. Unreadable to everyone else.</h2>
      </div>
      <div class="scene sc-share" data-scene="share" data-step="0">
        <div class="sc-person ben"><span class="sc-face">B</span><b>Ben</b></div>
        <div class="sc-person ann"><span class="sc-face">A</span><b>Ann</b><span class="sc-ok"><Icon name="check" size={14} /></span></div>
        <span class="sc-lane"><Icon name="chat" size={16} /><span>Slack, email, anything</span></span>
        <div class="sc-peek"><Icon name="eyeoff" size={20} /><code>Kx9#vQ2…</code></div>
      </div>
    </section>

    <section class="wrap" id="leak">
      <div class="head rv">
        <span class="eyebrow"><Icon name="alert" />5 · If it leaks</span>
        <h2>A leaked stand-in is stopped, and your whole team is covered.</h2>
      </div>
      <div class="scene sc-leak" data-scene="leak" data-step="0">
        <div class="sc-card sc-prog"><span class="sc-card-top"><Icon name="terminal" size={15} />report.py</span><span class="sc-slot"></span></div>
        <div class="sc-pkg"><Icon name="package" size={24} /><b>evil-package</b></div>
        <span class="sc-wire"><span>tripwire</span></span>
        <div class="sc-card sc-server bad"><span class="sc-card-top"><Icon name="out" size={15} />collect.example</span><span class="sc-got">Refused</span></div>
        <span class="sc-stop"><Icon name="shield" size={16} />Stopped</span>
        <div class="sc-team">{["A", "P", "M"].map((f) => <span class="sc-face sm">{f}<i><Icon name="shield" size={11} /></i></span>)}<span class="sc-team-say">Team covered</span></div>
      </div>
      <p class="limits rv"><a href="/docs/keyhandoff-run/">How tripwires work</a></p>
    </section>

    <section class="wrap" id="built-in">
      <div class="head center rv">
        <span class="eyebrow"><Icon name="shield" />6 · Built in, everywhere</span>
        <h2>It feels simple to use, but there&rsquo;s serious security underneath.</h2>
      </div>
      <div class="cutaway rv scene sc-locked" data-scene="locked" data-step="0">
        <div class="stack" aria-hidden="true">
          <div class="layer l-lock"><div class="plate"><Icon name="lock" size={64} /><span>Vault lock</span></div></div>
          <div class="layer l-core"><div class="plate">
            <span class="plate-name">Rust core</span>
            <code>Dialpad &nbsp;&nbsp;9f2c 0a71 e3b8 44d0</code>
            <code>Stripe &nbsp;&nbsp;&nbsp;c41e 77b2 0d9a f316</code>
            <code>OpenAI &nbsp;&nbsp;&nbsp;5be0 a3f9 12c7 8e4d</code>
          </div></div>
          <div class="beam"><span>Dialpad</span><span>Stripe</span><span>OpenAI</span></div>
          <div class="layer l-screen"><div class="plate"><img src="/shots/home.png" width="800" height="1200" loading="lazy" alt="" /><span class="locked-chip"><Icon name="lock" size={16} />Locked</span></div></div>
        </div>
        <div class="callouts">
          <div class="callout c-screen"><b>What you see</b><p>The window only ever gets a key&rsquo;s name, so there&rsquo;s nothing on screen for anyone to read over your shoulder.</p></div>
          <div class="callout c-core"><b>The Rust core</b><p>The real values stay down here, encrypted, and they never travel up to the screen.</p></div>
          <div class="callout c-lock"><b>The lock</b><p>It locks itself when your computer sleeps or your screen locks, and opens again with your passphrase or a short PIN.</p></div>
        </div>
      </div>
      <p class="limits rv"><a href="/docs/limits/">Read exactly what KeyHandoff protects</a></p>
    </section>

    <section class="wrap end rv" id="download" data-release-tag={release?.tag}>
      <span class="tile lg" data-home><Logo height={42} /></span>
      <h2>Safe secrets should be free. <br /><span class="pearl-text">So we made them free.</span></h2>
      <p class="sub">KeyHandoff is free and open source, for you, your team and everyone else. Fewer leaked keys makes the whole internet safer.</p>
      {release ? (
        <>
          <p class="release-meta">Version {release.version} · <time datetime={release.date}>{release.date}</time> · x86-64</p>
          <div class="downloads">
            {release.packages.map((pkg) => (
              <a class={`download ${pkg.id === "windows" ? "primary" : ""}`} data-download={pkg.id} href={pkg.url}>
                <span class="dl-name">{pkg.label}</span>
                <span class="dl-meta">{formatSize(pkg.size)}</span>
                <Icon name="right" />
              </a>
            ))}
          </div>
          <details class="install-help">
            <summary>Install help</summary>
            <ul class="install-notes">
            <li><b>Windows 10 or 11:</b> run the installer. It isn't code-signed yet, so SmartScreen may ask: choose <b>More info</b>, then <b>Run anyway</b>.</li>
            <li><b>Ubuntu, Debian and friends:</b> <code>sudo apt install ./{release.packages[1].name}</code></li>
            <li><b>Other Linux:</b> make the AppImage executable and run it. KeyHandoff needs X11; Wayland isn't supported yet.</li>
          </ul>
          </details>
          <p class="checksums">
            Check a download against <a href={release.checksumsURL}>SHA256SUMS</a> ·{" "}
            <a href={release.url}>Release notes</a> · <a href={ALL_RELEASES}>All releases</a> · <a href="/docs/install/">Install guide</a>
          </p>
        </>
      ) : (
        <>
          <p class="sub">Build it from source and try a handoff today.</p>
          <div class="cta">
            <a class="btn primary" href={GITHUB}>Get it on GitHub <Icon name="right" /></a>
            <a class="btn secondary" href="/docs/">Read the docs</a>
          </div>
        </>
      )}
    </section>

    <footer class="wrap">
      <div class="foot-brand">
        <a class="brand" href="/"><Logo height={30} />KeyHandoff</a>
        <p>API keys, hands off. No servers, no accounts.</p>
        <a class="made-by" href={MAKER}>made by <StrangeGlyph /> strange systems</a>
      </div>
      {FOOTER.map((col) => (
        <nav class="foot-col" aria-label={col.title}>
          <h4>{col.title}</h4>
          {col.links.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      ))}
      <div class="foot-base">
        <span>© 2026 strange systems</span>
        <a href={`${GITHUB}/blob/main/LICENSE`}>Open source under Apache 2.0</a>
      </div>
    </footer>

    <script>
      import "../scripts/site.ts";
      import "../scripts/keypath.ts";
      import "../scripts/pager.ts";
      import "../scripts/hero.ts";
    </script>
  </body>
</html>
