---
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import type { IconName } from "../components/Icon.astro";
import StrangeGlyph from "../components/StrangeGlyph.astro";
import Tile from "../components/Tile.astro";
import AppIcon from "../components/AppIcon.astro";
import AppPages from "../components/AppPages.astro";
import AppGlyph from "../components/AppGlyph.astro";
import appCss from "../../../src/styles.css?raw";
import { scopeAppCss } from "../lib/app-css.mjs";
import { getLatestRelease, formatSize, ALL_RELEASES } from "../lib/releases.mjs";

const title = "KeyHandoff: API keys, hands off";
const description = "Hand off API keys without anyone ever seeing them. From the moment a teammate sends you a key to the moment your code uses it, KeyHandoff keeps it hidden. No servers, no accounts.";
const GITHUB = "https://github.com/junovhs/keyhandoff";
// Null until the first release; then the end of the page offers its installers.
const release = await getLatestRelease();

const MAKER = "https://strangesystems.dev";
// The team section's opening and closing frames, shown a word at a time.
const INTRO = "Watch Ben send Ann a key without it ever touching the chat.";
const OUTRO = "It works over Slack, Teams, email or anything else you already use.";
// Ben's and Ann's windows are drawn with the app's own stylesheet.
const APP_CSS = scopeAppCss(appCss);

// The footer only links pages that exist on this site or in the repository.
const FOOTER: { title: string; links: [string, string][] }[] = [
  { title: "Learn", links: [["User manual", "/docs/"], ["Developer reference", "/docs/reference/"], ["Articles", "/articles/"]] },
  { title: "Project", links: [["GitHub", GITHUB], ["Releases", ALL_RELEASES], ["Report a vulnerability", `${GITHUB}/security`]] },
];

// All sample values, shaped like real keys and truncated.
const ENV_FILES = [
  { path: "~/work/billing-api/.env", vars: [{ name: "STRIPE_SECRET_KEY", key: "sk_live_51Nq8vTz", pointer: "handoff:Stripe" }] },
  { path: "~/work/report-bot/.env", vars: [{ name: "OPENAI_API_KEY", key: "sk-proj-Xk29fLm", pointer: "handoff:OpenAI" }] },
  { path: "~/side/prototype/.env", vars: [{ name: "AWS_SECRET_KEY", key: "wJ8rTq0ZnB5y", pointer: "handoff:AWS" }] },
];

// What each reader gets from a plain .env, and from one that holds pointers.
const READERS: { icon: IconName; name: string; how: string; gets: string; safe: string }[] = [
  { icon: "bot", name: "AI assistants", how: "Read your project files.", gets: "Can paste your key into a prompt.", safe: "Can only paste a useless pointer." },
  { icon: "package", name: "A poisoned package", how: "Runs as you on install.", gets: "Uploads your key in seconds.", safe: "Uploads a useless pointer." },
  { icon: "plugin", name: "A rogue extension", how: "Sees your whole workspace.", gets: "Can send your key anywhere.", safe: "Can only send a pointer." },
  { icon: "bug", name: "An infostealer", how: "Hunts for this filename.", gets: "Can sell your key to whoever's buying.", safe: "Has nothing worth selling." },
  { icon: "user", name: "Someone in your session", how: "One search is all it takes.", gets: "Copies your key in one go.", safe: "Copies a pointer, not a key." },
  { icon: "cloud", name: "Backup and sync", how: "Copies the file off your machine.", gets: "Puts your key in every copy.", safe: "Puts a pointer in every copy." },
];

const INCIDENTS = [
  { when: "Aug 2025", name: "Nx", text: "Poisoned releases hunted for .env files.", source: "StepSecurity", href: "https://www.stepsecurity.io/blog/supply-chain-security-alert-popular-nx-build-system-package-compromised-with-data-stealing-malware" },
  { when: "Sep 2025", name: "Shai-Hulud", text: "A worm that stole tokens to spread itself.", source: "Varonis", href: "https://www.varonis.com/blog/shai-hulud-campaigns" },
  { when: "May 2026", name: "node-ipc", text: "Its target list: .env.local, .env.production.", source: "Semgrep", href: "https://semgrep.dev/blog/2026/not-your-ipc-but-node-ipc-npm-hit-again-with-supply-chain-attack-but-this-time-its-not-a-worm" },
];

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://keyhandoff.dev/" />
    <meta name="theme-color" content="#000000" />
    <style is:inline set:html={APP_CSS}></style>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://keyhandoff.dev/" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <nav class="nav">
      <div class="wrap nav-in">
        <div class="lockup">
          <a class="lockup-mark" href="/" aria-label="KeyHandoff home"><Logo height={62} /></a>
          <div class="lockup-words">
            <a class="lockup-name" href="/">KeyHandoff</a>
            <a class="byline" href={MAKER}>by strange systems</a>
          </div>
        </div>
        <span class="sp"></span>
        <a class="l hide-s" href="#blind-spot">The blind spot</a>
        <a class="l hide-s" href="#solo">What it does</a>
        <a class="l" href="#download">Download</a>
        <a class="l" href="/docs/">Docs</a>
        <a class="l hide-s" href="/docs/reference/">Reference</a>
        <a class="btn secondary small" href={GITHUB}><svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg><span class="hide-xs">GitHub</span></a>
      </div>
    </nav>

    <header class="wrap hero">
      <div class="hero-copy">
        <h1>Your <code>.env</code> is<br />announcing itself.</h1>
        <p class="lede"><strong>And that&rsquo;s just one place your keys leak.</strong> KeyHandoff keeps them hidden from the provider&rsquo;s page to your code, and to anyone you share them with.</p>
        <div class="cta">
          <a class="btn primary" href="#download"><Icon name="down" />Download</a>
          <a class="btn secondary" href={GITHUB}>See the code <Icon name="out" /></a>
        </div>
      </div>

      <div class="scan-stage" id="scan" data-state="exposed">
        <figure class="scan">
          <div class="win-bar"><i></i><i></i><i></i><button type="button" class="replay-again" id="scan-again"><Icon name="right" size={14} />Replay</button></div>
          <div class="scan-body">
          <div class="scan-top">
            <span class="win-title"><Icon name="search" size={18} />Find in files</span>
            <span class="caps" aria-hidden="true"><kbd>Ctrl</kbd><kbd>F</kbd></span>
          </div>
          <div class="scan-field">
            <Icon name="search" size={18} />
            <span class="q"><span id="scan-q">.env</span><i class="caret"></i></span>
            <span class="count"><span class="count-bad"><Icon name="alert" size={15} />3 live keys</span><span class="count-ok"><Icon name="shield" size={15} />0 keys</span></span>
          </div>
          <div class="scan-rows" id="scan-rows">
            {ENV_FILES.map((f) => (
              <div class="group">
                <div class="row path"><Icon name="file" />{f.path}</div>
                {f.vars.map((v) => (
                  <div class="row var"><span class="k">{v.name}=</span><span class="v" data-key={v.key} data-pointer={v.pointer}>{v.key}</span></div>
                ))}
              </div>
            ))}
          </div>
          </div>
          <div class="scan-foot">
            <span class="scan-say" aria-live="polite"><span class="say-bad">Anyone can read these.</span><span class="say-ok">Now they&rsquo;re just pointers.</span></span>
            <span class="kh-switch" id="kh-switch"><Logo height={18} />KeyHandoff<i></i></span>
          </div>
          <svg class="cursor" id="scan-cursor" viewBox="0 0 16 22" width="22" height="30" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
        </figure>
      </div>

      <ul class="trust">
        <li><Icon name="offline" size={26} />No servers or accounts</li>
        <li><Icon name="eyeoff" size={26} />Keys never shown</li>
        <li><Icon name="book" size={26} />Free, public source</li>
        <li><Icon name="users" size={26} />Built in public</li>
      </ul>
    </header>

    <section class="wrap" id="blind-spot">
      <h2 class="big-q rv">Your <code>.env</code> hands your keys <br /><em>to anything that looks.</em></h2>

      <div class="readers rv" id="readers" data-state="exposed">
        <svg class="reader-lines" viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
          <path class="line" d="M335 70 C 385 70, 375 150, 422 165" /><path class="leak" d="M422 165 C 375 150, 385 70, 335 70" />
          <path class="line" d="M335 210 H422" /><path class="leak" d="M422 210 H335" />
          <path class="line" d="M335 350 C 385 350, 375 270, 422 255" /><path class="leak" d="M422 255 C 375 270, 385 350, 335 350" />
          <path class="line" d="M578 165 C 625 150, 615 70, 665 70" /><path class="leak" d="M578 165 C 625 150, 615 70, 665 70" />
          <path class="line" d="M578 210 H665" /><path class="leak" d="M578 210 H665" />
          <path class="line" d="M578 255 C 625 270, 615 350, 665 350" /><path class="leak" d="M578 255 C 625 270, 615 350, 665 350" />
        </svg>
        {READERS.map((_, i) => <i class:list={["reader-dot", `d${i}`]} aria-hidden="true"></i>)}
        {READERS.map((r, i) => (
          <div class:list={["reader", `r${i}`]}>
            <span class="reader-ico"><Icon name={r.icon} size={44} /></span>
            <span class="reader-txt"><b>{r.name}</b><span>{r.how}</span><span class="gets"><span class="bad">{r.gets}</span><span class="ok">{r.safe}</span></span></span>
          </div>
        ))}
        <div class="envfile">
          <span class="ring"></span><span class="ring two"></span>
          <Tile name="file" scale={5} size="lg" plain />
          <code>.env</code>
          <span class="env-val" id="env-val" data-key="sk_live_51Nq8vTz" data-pointer="handoff:Stripe">sk_live_51Nq8vTz</span>
          <span class="env-kind"><span class="bad">plain text</span><span class="ok">pointer only</span></span>
        </div>
      </div>
      <div class="readers-switch rv">
        <div class="segmented" role="group" aria-label="Compare">
          <button type="button" data-to="exposed" aria-pressed="true">Plain .env</button>
          <button type="button" data-to="safe" aria-pressed="false">With KeyHandoff</button>
        </div>
      </div>
      <p class="proof-line rv">This keeps happening. Look up {INCIDENTS.map((n, i) => <>{i ? (i === INCIDENTS.length - 1 ? " and " : ", ") : ""}<a href={n.href}>{n.name}</a></>)}.</p>
      <p class="punch rv" id="punch" data-state="exposed">
        <span data-bad="Right now your keys sit in a plain text file." data-ok="Your keys live in an encrypted vault.">Right now your keys sit in a plain text file.</span><br />
        <strong data-bad="Anything that can read it can take them." data-ok="Your .env only holds a pointer.">Anything that can read it can take them.</strong>
      </p>
    </section>

    <section class="wrap panel" id="solo">
      <div class="head rv">
        <span class="eyebrow"><Icon name="key" />1 · Keep it</span>
        <h2>Copy a new key once, and it goes straight into your vault.</h2>
        <p class="sub">When you need it somewhere, KeyHandoff types it in for you.</p>
      </div>
      <div class="solo-stage rv" id="solo-stage" data-step="0">
        <p class="duo-cap" aria-live="polite">
          <span class="s0"><b>1</b>Copy your key once.</span>
          <span class="s1"><b>2</b>KeyHandoff catches it and wipes your clipboard.</span>
          <span class="s2"><b>3</b>Now it&rsquo;s sealed in your vault.</span>
          <span class="s3"><b>4</b>Click a field, then pick the key to type it in.</span>
        </p>
        <div class="kh" aria-hidden="true">
          <div class="app">
            <header class="titlebar"><Logo height={22} /><span class="name">KeyHandoff</span><button><AppIcon name="lock" /></button><button><AppIcon name="minimize" /></button><button><AppIcon name="close" /></button></header>
            <!-- One Safe Copy screen for listening and caught, so the check lands the instant Ctrl C is pressed. -->
            <div class="safe view s0 s1 catch">
              <div class="top"><AppIcon name="shield" /><b>Safe Copy</b></div>
              <div class="safe-body">
                <div class="safe-stage">
                  <AppPages mark="none" />
                  <h2 class="display flip"><span class="before">Copy your key</span><span class="after">Caught</span></h2>
                  <p class="sub flip"><span class="before">From anywhere · 42s</span><span class="after">Clipboard wiped.</span></p>
                </div>
                <div class="below after">
                  <span class="name-in">Stripe (billing)</span>
                  <div class="keep-buttons"><button><AppIcon name="once" />Use once</button><button><AppIcon name="calendar" />Keep 30 days</button><button class="choose"><AppIcon name="forever" />Keep forever</button></div>
                </div>
              </div>
            </div>
            <div class="stage view s2 s3">
              <div class="hero"><h1 class="display sm">Your keys</h1><p class="lede">3 keys · all sealed on this computer</p></div>
              <div class="btn-row"><button class="btn primary grow">Add a key</button><button class="btn secondary grow">Send a key</button></div>
              <div class="vault"><div class="keys"><div class="key-row fresh"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Stripe (billing)</span><span class="meta">Yours · Kept</span></span><button class="use always type-btn" id="solo-type">Type</button></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Dialpad</span><span class="meta">From Ben · Kept</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">OpenAI</span><span class="meta">Yours · Kept</span></span></div></div></div>
            </div>
          </div>
        </div>
        <div class="source s0 s1" aria-hidden="true">
          <span class="source-title">API keys</span>
          <span class="source-label">Secret key</span>
          <span class="source-key"><code>sk_live_51Nq8vTz</code></span>
          <span class="caps"><kbd>Ctrl</kbd><kbd>C</kbd></span>
        </div>
        <div class="source field-card s3" aria-hidden="true">
          <span class="source-title">Deploy settings</span>
          <span class="source-label">Stripe secret key</span>
          <span class="field-box" id="solo-field"><span class="dots"></span><i class="caret"></i></span>
          <span class="typing-chip"><Logo height={14} />KeyHandoff is typing</span>
        </div>
        <svg class="cursor" id="solo-cursor" viewBox="0 0 16 22" width="22" height="30" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.7 3-1.4-3-6.6H14z" /></svg>
      </div>
    </section>

    <section class="wrap split" id="code">
      <div class="split-copy rv">
        <span class="eyebrow"><Icon name="terminal" />2 · Use it</span>
        <h2>Your code uses the key, and you decide which programs get it.</h2>
        <p class="sub">Your <code>.env</code> holds a pointer like <code>handoff:OpenAI</code> where the key used to be. When your program starts, it asks KeyHandoff over a private pipe on your machine, and the first time, you say whether that program in that folder is allowed.</p>
      </div>
      <div class="prompt rv">
        <div class="prompt-top"><span class="tile sm"><Logo height={21} /></span><b>KeyHandoff</b><span>A program is asking</span></div>
        <p class="prompt-q"><code>report.py</code> wants the <b>Dialpad</b> key</p>
        <p class="prompt-where"><Icon name="file" size={14} />~/work/report-bot</p>
        <div class="prompt-btns"><span class="btn secondary small">Just this once</span><span class="btn primary small">Always allow</span></div>
      </div>
    </section>

    <section class="wrap panel" id="team">
      <div class="head rv">
        <span class="eyebrow"><Icon name="users" />3 · Share it</span>
        <h2>Need to share a key? We solved that too.</h2>
      </div>
      <div class="team-stage rv" id="duo" data-step="intro">
        <div class="frame-card f-intro" aria-hidden="true">
          <div class="pair">
            <span class="person"><i>B</i>Ben</span>
            <span class="line"><span class="file-chip"><Icon name="file" size={14} />Key for Ann.handoff</span></span>
            <span class="person"><i>A</i>Ann</span>
          </div>
          <p class="frame-text">{INTRO.split(" ").map((w, i) => <span style={`--i:${i}`}>{w} </span>)}</p>
        </div>
        <div class="frame-card f-outro" aria-hidden="true">
          <div class="chat">
            <span class="chat-av">B</span>
            <div class="chat-body">
              <span class="chat-head"><b>Ben</b>10:42</span>
              <span class="chat-msg">Here&rsquo;s the Dialpad key.</span>
              <span class="file-chip"><Icon name="file" size={14} />Key for Ann.handoff</span>
            </div>
          </div>
          <p class="frame-text">{OUTRO.split(" ").map((w, i) => <span style={`--i:${i}`}>{w} </span>)}</p>
        </div>
        <p class="duo-cap" aria-live="polite">
          <span class="s0"><b>1</b>Ben picks Ann.</span>
          <span class="s1"><b>2</b>Then he picks the key.</span>
          <span class="s2"><b>3</b>KeyHandoff seals it for Ann.</span>
          <span class="s3"><b>4</b>Ann opens it and keeps it.</span>
          <span class="s4"><b>5</b>The copy in the chat is now useless.</span>
        </p>
      <div class="duo">
        <div class="mock ben">
          <span class="mock-who">Ben&rsquo;s computer</span>
          <div class="kh" aria-hidden="true">
            <div class="app">
              <header class="titlebar"><Logo height={22} /><span class="name">KeyHandoff</span><button><AppIcon name="lock" /></button><button><AppIcon name="minimize" /></button><button><AppIcon name="close" /></button></header>
              <div class="sheet view s0">
                <div class="hero"><h2 class="display md">Send a key</h2><p class="lede">Who&rsquo;s it for?</p></div>
                <div class="keys"><span class="label">Teams</span><div class="key-row"><span class="key-ico"><AppIcon name="users" /></span><span class="who"><span class="nm">Platform</span><span class="meta">Ann, Priya</span></span></div></div>
                <div class="keys"><span class="label">People</span><div class="key-row pick"><span class="key-ico"><AppIcon name="user" /></span><span class="who"><span class="nm">Ann</span><span class="meta">9 sends left · <span class="mono">ann-thinkpad</span></span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="user" /></span><span class="who"><span class="nm">Priya</span><span class="meta">14 sends left · <span class="mono">priya-desk</span></span></span></div></div>
              </div>
              <div class="sheet view s1">
                <div class="hero"><h2 class="display md">Send to Ann</h2><p class="lede">Which key?</p></div>
                <div class="keys"><div class="key-row pick"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Dialpad</span><span class="meta">Yours</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Stripe (billing)</span><span class="meta">From Priya · Platform</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">OpenAI</span><span class="meta">Yours</span></span></div></div>
                <span class="grow-space"></span>
                <div class="btn-row"><button class="btn secondary grow">Back</button></div>
              </div>
              <div class="safe sealed view s2 s3 s4">
                <div class="top"><AppIcon name="shield" /><b>Send a key</b><span>for Ann</span></div>
                <div class="safe-body">
                  <div class="safe-stage"><AppPages mark="lock" /><h2 class="display">Sealed</h2><p class="sub">Only Ann&rsquo;s computer can open it.</p></div>
                  <div class="below">
                    <div class="file-row"><div class="chip"><AppIcon name="file" /><span class="mono">Key for Ann.handoff</span></div><button class="btn primary">Copy</button></div>
                    <p class="help center">The file is deleted when you close this.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="hop" aria-hidden="true"><span class="file-chip"><Icon name="file" size={14} />Key for Ann.handoff</span></div>
        <div class="mock ann">
          <span class="mock-who">Ann&rsquo;s computer</span>
          <div class="kh" aria-hidden="true">
            <div class="app">
              <header class="titlebar"><Logo height={22} /><span class="name">KeyHandoff</span><button><AppIcon name="lock" /></button><button><AppIcon name="minimize" /></button><button><AppIcon name="close" /></button></header>
              <div class="stage view s0 s1 s2">
                <div class="hero"><h1 class="display sm">Your keys</h1><p class="lede">2 keys · all sealed on this computer</p></div>
                <div class="btn-row"><button class="btn primary grow">Add a key</button><button class="btn secondary grow">Send a key</button></div>
                <div class="vault"><div class="keys"><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Stripe (billing)</span><span class="meta">From Priya · Platform · 27 days left</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">OpenAI</span><span class="meta">Yours · Kept</span></span></div></div></div>
                <div class="foot"><span class="me"><button>You are <b>Ann</b></button> · <button><b>Your card</b></button> · <button><b>Security</b></button></span><span class="paste">Paste a file <kbd>Ctrl V</kbd></span></div>
              </div>
              <div class="sheet view s3">
                <div class="head"><AppGlyph mark="check" /><div><span class="lede">Ben sent you a key</span><h2 class="display md">Dialpad</h2></div></div>
                <div class="keep-block">
                  <div class="keep-buttons"><button><AppIcon name="once" />Use once</button><button><AppIcon name="calendar" />Keep 30 days</button><button class="choose"><AppIcon name="forever" />Keep forever</button></div>
                  <p class="help">Kept until you remove it.</p>
                </div>
              </div>
              <div class="stage view s4">
                <div class="hero"><h1 class="display sm">Your keys</h1><p class="lede">3 keys · all sealed on this computer</p></div>
                <div class="btn-row"><button class="btn primary grow">Add a key</button><button class="btn secondary grow">Send a key</button></div>
                <div class="vault"><div class="keys"><div class="key-row fresh"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Dialpad</span><span class="meta">From Ben · Kept</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">Stripe (billing)</span><span class="meta">From Priya · Platform · 27 days left</span></span></div><div class="key-row"><span class="key-ico"><AppIcon name="key" /></span><span class="who"><span class="nm">OpenAI</span><span class="meta">Yours · Kept</span></span></div></div></div>
                <div class="foot"><span class="me"><button>You are <b>Ann</b></button> · <button><b>Your card</b></button> · <button><b>Security</b></button></span><span class="paste">Paste a file <kbd>Ctrl V</kbd></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </section>

    <section class="wrap" id="circle">
      <div class="head rv">
        <span class="eyebrow"><Icon name="users" />How teams work</span>
        <h2>Start on your own. Add teammates when you need them.</h2>
      </div>
      <div class="circle-stage rv" id="circle-stage" data-step="0">
        <p class="duo-cap" aria-live="polite">
          <span class="s0"><b>1</b>On your own, it&rsquo;s already a vault for your keys.</span>
          <span class="s1"><b>2</b>To add Ann, she sends you her card once.</span>
          <span class="s2"><b>3</b>Make a team, and one send reaches everyone.</span>
        </p>
        <div class="circle-map" aria-hidden="true">
          <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none">
            <line class="to-ann" x1="22" y1="50" x2="68" y2="30" />
            <line class="to-priya" x1="22" y1="50" x2="84" y2="56" />
            <line class="to-ben" x1="22" y1="50" x2="66" y2="76" />
          </svg>
          <span class="team-ring"><span>Platform team</span></span>
          <span class="peer you" style="--x:22%; --y:50%"><i>You</i><em><Icon name="lock" size={13} />3 keys</em></span>
          <span class="peer p-ann" style="--x:68%; --y:30%"><i>A</i>Ann</span>
          <span class="peer p-priya" style="--x:84%; --y:56%"><i>P</i>Priya</span>
          <span class="peer p-ben" style="--x:66%; --y:76%"><i>B</i>Ben</span>
          <span class="file-chip card-chip"><Icon name="file" size={14} />Ann&rsquo;s card</span>
          <span class="copy" style="--x:68%; --y:30%"><Icon name="key" size={14} /></span>
          <span class="copy" style="--x:84%; --y:56%; --d:.15s"><Icon name="key" size={14} /></span>
          <span class="copy" style="--x:66%; --y:76%; --d:.3s"><Icon name="key" size={14} /></span>
        </div>
      </div>
      <p class="wire-note rv"><Icon name="shield" />A card holds no secret, and there&rsquo;s no server or sign-up: your teams live on your computer.</p>
    </section>

    <section class="wrap" id="built-in">
      <div class="head center rv">
        <span class="eyebrow"><Icon name="shield" />Built in, everywhere</span>
        <h2>It feels simple to use, but there&rsquo;s serious security underneath.</h2>
      </div>
      <div class="cutaway rv">
        <div class="stack" aria-hidden="true">
          <div class="layer l-lock"><div class="plate"><Icon name="lock" size={64} /><span>Vault lock</span></div></div>
          <div class="layer l-core"><div class="plate">
            <span class="plate-name">Rust core</span>
            <code>Dialpad &nbsp;&nbsp;9f2c 0a71 e3b8 44d0</code>
            <code>Stripe &nbsp;&nbsp;&nbsp;c41e 77b2 0d9a f316</code>
            <code>OpenAI &nbsp;&nbsp;&nbsp;5be0 a3f9 12c7 8e4d</code>
          </div></div>
          <div class="beam"><span>Dialpad</span><span>Stripe</span><span>OpenAI</span></div>
          <div class="layer l-screen"><div class="plate"><img src="/shots/home.png" width="800" height="1200" loading="lazy" alt="" /><span class="locked-chip"><Icon name="lock" size={16} />Locked</span></div></div>
        </div>
        <div class="callouts">
          <div class="callout c-screen"><b>What you see</b><p>The window only ever gets a key&rsquo;s name, so there&rsquo;s nothing on screen for anyone to read over your shoulder.</p></div>
          <div class="callout c-core"><b>The Rust core</b><p>The real values stay down here, encrypted, and they never travel up to the screen.</p></div>
          <div class="callout c-lock"><b>The lock</b><p>It locks itself when your computer sleeps or your screen locks, and opens again with your passphrase or a short PIN.</p></div>
        </div>
      </div>
      <p class="limits rv"><a href="/docs/limits/">Read exactly what KeyHandoff protects</a></p>
    </section>

    <section class="wrap end rv" id="download" data-release-tag={release?.tag}>
      <span class="tile lg"><Logo height={42} /></span>
      <h2>Get your keys out of the file.</h2>
      {release ? (
        <>
          <p class="sub">KeyHandoff is in pre-release and hasn't had a security audit, so start with test keys.</p>
          <p class="release-meta">Version {release.version} · <time datetime={release.date}>{release.date}</time> · x86-64</p>
          <div class="downloads">
            {release.packages.map((pkg) => (
              <a class={`download ${pkg.id === "windows" ? "primary" : ""}`} data-download={pkg.id} href={pkg.url}>
                <span class="dl-name">{pkg.label}</span>
                <span class="dl-meta">{formatSize(pkg.size)}</span>
                <Icon name="right" />
              </a>
            ))}
          </div>
          <details class="install-help">
            <summary>Install help</summary>
            <ul class="install-notes">
            <li><b>Windows 10 or 11:</b> run the installer. It isn't code-signed yet, so SmartScreen may ask: choose <b>More info</b>, then <b>Run anyway</b>.</li>
            <li><b>Ubuntu, Debian and friends:</b> <code>sudo apt install ./{release.packages[1].name}</code></li>
            <li><b>Other Linux:</b> make the AppImage executable and run it. KeyHandoff needs X11; Wayland isn't supported yet.</li>
          </ul>
          </details>
          <p class="checksums">
            Check a download against <a href={release.checksumsURL}>SHA256SUMS</a> ·{" "}
            <a href={release.url}>Release notes</a> · <a href={ALL_RELEASES}>All releases</a> · <a href="/docs/install/">Install guide</a>
          </p>
        </>
      ) : (
        <>
          <p class="sub">KeyHandoff is in pre-release, so start with test keys. Build it from source and try a handoff today.</p>
          <div class="cta">
            <a class="btn primary" href={GITHUB}>Get it on GitHub <Icon name="right" /></a>
            <a class="btn secondary" href="/docs/">Read the docs</a>
          </div>
        </>
      )}
    </section>

    <footer class="wrap">
      <div class="foot-brand">
        <a class="brand" href="/"><Logo height={30} />KeyHandoff</a>
        <p>API keys, hands off. No servers, no accounts.</p>
        <a class="made-by" href={MAKER}>made by <StrangeGlyph /> strange systems</a>
      </div>
      {FOOTER.map((col) => (
        <nav class="foot-col" aria-label={col.title}>
          <h4>{col.title}</h4>
          {col.links.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      ))}
      <div class="foot-base">
        <span>© 2026 strange systems</span>
        <a href={`${GITHUB}/blob/main/LICENSE.md`}>Source under PolyForm Shield 1.0.0</a>
      </div>
    </footer>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
