---
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import type { IconName } from "../components/Icon.astro";
import Status from "../components/Status.astro";
import StrangeGlyph from "../components/StrangeGlyph.astro";
import Tile from "../components/Tile.astro";

const title = "KeyHandoff: API keys, hands off";
const description = "Your .env is announcing itself. KeyHandoff catches, seals and hands off API keys so they stop living in plain text files and chats. No servers, no accounts.";
const GITHUB = "https://github.com/junovhs/keyhandoff";
const MAKER = "https://strangesystems.dev";

// All sample values, shaped like real keys and truncated.
const ENV_FILES = [
  { path: "~/work/billing-api/.env", vars: [
    { name: "STRIPE_SECRET_KEY", key: "sk_live_51Nq8vTzK2mPx", pointer: "handoff:Stripe" },
    { name: "DATABASE_URL", key: "postgres://admin:hG7xQ2@db", pointer: "handoff:BillingDB" },
  ] },
  { path: "~/work/report-bot/.env", vars: [
    { name: "OPENAI_API_KEY", key: "sk-proj-Xk29fLmQ7vRb", pointer: "handoff:OpenAI" },
    { name: "DIALPAD_API_KEY", key: "dp_7Qm2vX9kLw4Tz", pointer: "handoff:Dialpad" },
  ] },
  { path: "~/side/old-prototype/.env", vars: [
    { name: "AWS_SECRET_ACCESS_KEY", key: "wJ8rTq0ZnB5yHc2Lp", pointer: "handoff:AWS" },
  ] },
];

const READERS: { icon: IconName; name: string; lines: string[]; blocked?: boolean }[] = [
  { icon: "bot", name: "AI assistants", lines: ["Can read your files.", "May use them in prompts or tools."], blocked: true },
  { icon: "package", name: "A poisoned package", lines: ["Runs as you install.", "Can read your files."] },
  { icon: "plugin", name: "A rogue extension", lines: ["Sees your whole workspace.", "Can find your keys."] },
  { icon: "bug", name: "An infostealer", lines: ["Searches for this filename.", "Can exfiltrate your keys."] },
  { icon: "user", name: "Someone in your session", lines: ["One search and they're done.", "Can read and copy the file."] },
  { icon: "cloud", name: "Backup and sync", lines: ["Copies it off your machine.", "Now it's everywhere."] },
];

const INCIDENTS = [
  { when: "Aug 2025", name: "Nx build system", text: "Poisoned releases searched for .env files, using local AI coding tools as the search party.", source: "StepSecurity", href: "https://www.stepsecurity.io/blog/supply-chain-security-alert-popular-nx-build-system-package-compromised-with-data-stealing-malware" },
  { when: "Sep 2025", name: "Shai-Hulud worm", text: "An npm worm scanned infected machines for secrets, then used stolen tokens to backdoor more packages.", source: "Varonis", href: "https://www.varonis.com/blog/shai-hulud-campaigns" },
  { when: "May 2026", name: "node-ipc", text: "Live for about two hours. Its target list spelled it out: .env.local, .env.production.", source: "Semgrep", href: "https://semgrep.dev/blog/2026/not-your-ipc-but-node-ipc-npm-hit-again-with-supply-chain-attack-but-this-time-its-not-a-worm" },
];

// The replay. Times are ms from the start; the keys are the same samples as the hero.
const YOU_SEE = [
  { at: 0, text: "$ npm install" },
  { at: 900, text: "" },
  { at: 7000, text: "added 312 packages in 9s" },
  { at: 7300, text: "" },
  { at: 7500, text: "64 packages are looking for funding" },
  { at: 7700, text: "  run `npm fund` for details" },
  { at: 8000, text: "$ " },
];
const IT_RAN: { at: number; text: string; kind?: string }[] = [
  { at: 1000, text: "postinstall: running as you" },
  { at: 1900, text: "$ find ~ -name \".env*\"" },
  { at: 2500, text: "  ~/work/billing-api/.env" },
  { at: 2700, text: "  ~/work/report-bot/.env" },
  { at: 2900, text: "  ~/side/old-prototype/.env" },
  { at: 3100, text: "  ...and 44 more" },
  { at: 3900, text: "STRIPE_SECRET_KEY=sk_live_51Nq8vTzK2mPx", kind: "hit" },
  { at: 4150, text: "OPENAI_API_KEY=sk-proj-Xk29fLmQ7vRb", kind: "hit" },
  { at: 4400, text: "AWS_SECRET_ACCESS_KEY=wJ8rTq0ZnB5yHc2Lp", kind: "hit" },
  { at: 4650, text: "DATABASE_URL=postgres://admin:hG7xQ2@db", kind: "hit" },
  { at: 5400, text: "checking which keys still work... 4 of 4" },
  { at: 6300, text: "uploaded. removing traces.", kind: "done" },
];

const WORTH: { icon: IconName; name: string; text: string }[] = [
  { icon: "key", name: "STRIPE_SECRET_KEY", text: "Customer records, refunds and payouts. It's your money." },
  { icon: "cloud", name: "AWS_SECRET_ACCESS_KEY", text: "Servers on your bill. Whatever is in your buckets." },
  { icon: "bot", name: "OPENAI_API_KEY", text: "Someone else's traffic on your credit card." },
  { icon: "users", name: "DATABASE_URL", text: "Every row you have, and an email to write to your customers." },
];

const TEAM_SCREENS = [
  { src: "/shots/ask.png", who: "Ann", title: "Ask", text: "One click copies a request. No secret inside.", alt: "KeyHandoff showing Request copied, with a file called Key request from Ann.handoff" },
  { src: "/shots/listening.png", who: "Ben", title: "Catch", text: "Ben copies the key. KeyHandoff catches that one copy.", alt: "KeyHandoff Safe Copy listening for a copy, showing that Ann is asking and her computer's fingerprint" },
  { src: "/shots/sealed.png", who: "Ben", title: "Seal", text: "Only Ann's computer can open it. Ben keeps nothing.", alt: "KeyHandoff showing Sealed for Ann, with a file called Key for Ann.handoff" },
  { src: "/shots/accepted.png", who: "Ann", title: "Keep", text: "It lands in Ann's vault. The copy in the chat is dead.", alt: "KeyHandoff showing Ben sent you a key, with choices of Once, 30 days or Keep" },
];

const BUILT_IN: { icon: IconName; title: string; text: string }[] = [
  { icon: "eyeoff", title: "Nothing to shoulder-surf", text: "KeyHandoff has no way to show a key on screen." },
  { icon: "chip", title: "Secrets stay in the Rust core", text: "The screens only get names and ids, never values." },
  { icon: "flame", title: "One open, then gone", text: "After one open, every copy of a sealed file is unreadable." },
  { icon: "chat", title: "Works in any chat", text: "Ordinary files, or pasted text that repairs itself when mangled." },
  { icon: "offline", title: "No servers, no accounts", text: "No sign-up, no cloud, no telemetry and no network code." },
  { icon: "book", title: "Open to read", text: "Read every line, free at work. The sealing library is Apache 2.0." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://keyhandoff.dev/" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://keyhandoff.dev/" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <nav class="nav">
      <div class="wrap nav-in">
        <div class="lockup">
          <a class="lockup-mark" href="/" aria-label="KeyHandoff home"><Logo height={62} /></a>
          <div class="lockup-words">
            <a class="lockup-name" href="/">KeyHandoff</a>
            <a class="byline" href={MAKER}>by strange systems</a>
          </div>
        </div>
        <span class="sp"></span>
        <a class="l hide-s" href="#blind-spot">The blind spot</a>
        <a class="l hide-s" href="#fronts">What it does</a>
        <a class="l hide-s" href="#roadmap">Roadmap</a>
        <a class="l" href="/docs/">Docs</a>
        <a class="btn secondary small" href={GITHUB}><svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg><span class="hide-xs">GitHub</span></a>
      </div>
    </nav>

    <header class="wrap hero">
      <div class="hero-copy">
        <h1>Your <code>.env</code> is<br />announcing itself.</h1>
        <p class="lede">API keys in plain text .env files are easy to find. KeyHandoff removes your keys from the file and seals them in a vault.</p>
        <div class="cta">
          <a class="btn primary" href="#blind-spot">See the blind spot <Icon name="right" /></a>
          <a class="btn secondary" href="#fronts">What KeyHandoff does</a>
        </div>
      </div>

      <div class="scan-stage" id="scan" data-state="exposed">
        <figure class="scan">
          <div class="win-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="scan-top">
            <span class="win-title"><Icon name="search" size={18} />Find in files</span>
            <span class="caps" aria-hidden="true"><kbd>Ctrl</kbd><kbd>F</kbd></span>
          </div>
          <div class="scan-field">
            <Icon name="search" size={18} />
            <span class="q"><span id="scan-q">.env</span><i class="caret"></i></span>
            <span class="count"><span class="count-bad"><Icon name="alert" size={15} />3 files, 5 live keys</span><span class="count-ok"><Icon name="shield" size={15} />3 files, 0 keys</span></span>
          </div>
          <div class="scan-rows" id="scan-rows">
            {ENV_FILES.map((f) => (
              <div class="group">
                <div class="row path"><Icon name="file" />{f.path}</div>
                {f.vars.map((v) => (
                  <div class="row var"><span class="k">{v.name}=</span><span class="v" data-key={v.key} data-pointer={v.pointer}>{v.key}</span></div>
                ))}
              </div>
            ))}
          </div>
          <div class="scan-foot">
            <div class="segmented" role="group" aria-label="Compare">
              <button type="button" data-to="exposed" aria-pressed="true">Today</button>
              <button type="button" data-to="safe" aria-pressed="false">With KeyHandoff</button>
            </div>
            <Status kind="building" label="Pointers in progress" />
          </div>
        </figure>
      </div>

      <ul class="trust">
        <li><Icon name="offline" size={26} />No servers</li>
        <li><Icon name="user" size={26} />No accounts</li>
        <li><Icon name="eyeoff" size={26} />Keys never shown</li>
        <li><Icon name="book" size={26} />Free and open to read</li>
      </ul>
    </header>

    <section class="wrap" id="blind-spot">
      <h2 class="big-q rv">Everyone's guarding their API keys from AI. <br />Who's guarding them from <em>everything else?</em></h2>

      <div class="readers rv">
        <svg class="reader-lines" viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
          <path class="stop" d="M335 70 C 385 70, 375 150, 422 165" />
          <path class="line" d="M335 210 H422" /><path class="leak" d="M422 210 H335" />
          <path class="line" d="M335 350 C 385 350, 375 270, 422 255" /><path class="leak" d="M422 255 C 375 270, 385 350, 335 350" />
          <path class="line" d="M578 165 C 625 150, 615 70, 665 70" /><path class="leak" d="M578 165 C 625 150, 615 70, 665 70" />
          <path class="line" d="M578 210 H665" /><path class="leak" d="M578 210 H665" />
          <path class="line" d="M578 255 C 625 270, 615 350, 665 350" /><path class="leak" d="M578 255 C 625 270, 615 350, 665 350" />
        </svg>
        {READERS.map((r, i) => <i class:list={["reader-dot", `d${i}`, { blocked: r.blocked }]} aria-hidden="true"></i>)}
        {READERS.map((r, i) => (
          <div class:list={["reader", `r${i}`, { blocked: r.blocked }]}>
            <span class="reader-ico"><Icon name={r.icon} size={44} /></span>
            <span class="reader-txt"><b>{r.name}</b>{r.lines.map((l) => <span>{l}</span>)}</span>
          </div>
        ))}
        <div class="envfile">
          <span class="ring"></span><span class="ring two"></span>
          <Tile name="file" scale={5} size="lg" plain />
          <code>.env</code>
          <span>plain text</span>
        </div>
      </div>
      <p class="punch rv">Ignore rules stop <em>one</em> of these.<br /><strong>Take the key out of the file, and a search finds nothing.</strong></p>
    </section>

    <section class="wrap" id="replay">
      <div class="head rv">
        <span class="eyebrow alarm"><Icon name="flame" />How it actually goes</span>
        <h2>You won't see it happen.</h2>
        <p class="sub">One bad dependency. One normal install. The same moment from both sides.</p>
      </div>

      <div class="replay rv" id="replay-stage">
        <div class="replay-bar">
          <span class="replay-clock"><i></i><span id="replay-clock">00:09</span></span>
          <span class="replay-note">Illustration, based on the real campaigns below</span>
          <button type="button" class="replay-again" id="replay-again"><Icon name="right" size={14} />Replay</button>
        </div>
        <div class="replay-panes">
          <div class="pane calm">
            <span class="pane-label"><Icon name="eyeoff" size={14} />What you see</span>
            <pre class="term">{YOU_SEE.map((l) => <span class="line" data-at={l.at}>{l.text}</span>)}</pre>
          </div>
          <div class="pane hostile">
            <span class="pane-label"><Icon name="bug" size={14} />What ran as you</span>
            <pre class="term">{IT_RAN.map((l) => <span class:list={["line", l.kind]} data-at={l.at}>{l.text}</span>)}</pre>
          </div>
        </div>
        <p class="replay-end line" data-at="8200"><b>No crash. No warning. No prompt.</b> Your tests pass, your day goes on, and you find out from an invoice, or from a customer.</p>
      </div>

      <div class="head sub-head rv">
        <h3 class="big">One key is never just one key.</h3>
      </div>
      <div class="worth">
        {WORTH.map((w, i) => (
          <div class="worth-cell rv" style={`--d:${i * 70}ms`}>
            <span class="worth-top"><Icon name={w.icon} size={18} /><code>{w.name}</code></span>
            <p>{w.text}</p>
          </div>
        ))}
      </div>

      <div class="head sub-head rv">
        <h3 class="big">This keeps happening.</h3>
      </div>
      <div class="incidents">
        {INCIDENTS.map((n, i) => (
          <a class="incident rv" style={`--d:${i * 80}ms`} href={n.href}>
            <span class="when">{n.when}</span>
            <h3>{n.name}</h3>
            <p>{n.text}</p>
            <span class="src">{n.source} <Icon name="out" size={13} /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap" id="fronts">
      <div class="head center rv">
        <span class="eyebrow"><Icon name="key" />What KeyHandoff does</span>
        <h2>One vault. Three places your keys stop leaking.</h2>
      </div>
      <div class="hub rv" aria-hidden="true">
        <span class="hub-mark"><span class="tile lg"><Logo height={42} /></span></span>
        <svg viewBox="0 0 1000 90" preserveAspectRatio="none">
          <path d="M500 0 C 500 50, 166 40, 166 90" /><path d="M500 0 V 90" /><path d="M500 0 C 500 50, 834 40, 834 90" />
        </svg>
      </div>
      <div class="fronts">
        <a class="front rv" href="#solo">
          <Tile name="key" scale={3} />
          <h3>Just you</h3>
          <p>Every key in one sealed place, typed out for you when you need it.</p>
          <span class="stack"><Status kind="now" label="Save: now" /><Status kind="building" label="Type: in progress" /></span>
        </a>
        <a class="front rv" style="--d:80ms" href="#code">
          <Tile name="file" scale={3} />
          <h3>Your code</h3>
          <p>Pointers in <code>.env</code> instead of secrets. Your programs ask the vault.</p>
          <span class="stack"><Status kind="building" /></span>
        </a>
        <a class="front rv" style="--d:160ms" href="#team">
          <Tile name="send" scale={4} />
          <h3>Your team</h3>
          <p>Send a request, get a sealed reply. The chat only carries a useless file.</p>
          <span class="stack"><Status kind="now" /></span>
        </a>
      </div>
    </section>

    <section class="wrap split" id="solo">
      <div class="split-copy rv">
        <span class="eyebrow"><Icon name="user" />Just you</span>
        <h2>Every key in one place. None of them in your way.</h2>
        <ul class="feats">
          <li><span class="f-ico"><Icon name="clip" size={18} /></span><div><h3>Bring it in <Status kind="now" /></h3><p>Copy the key once. Safe Copy catches it and wipes the clipboard.</p></div></li>
          <li><span class="f-ico"><Icon name="clock" size={18} /></span><div><h3>Keep it your way <Status kind="now" /></h3><p>One tap: <b>Once</b>, <b>30 days</b> or <b>Keep</b>. Sealed on this device.</p></div></li>
          <li><span class="f-ico"><Icon name="type" size={18} /></span><div><h3>Have it typed out <Status kind="building" /></h3><p>Click a box and KeyHandoff types the key straight into it.</p></div></li>
        </ul>
      </div>
      <div class="split-art solo-art rv">
        <figure class="shot back"><img src="/shots/listening.png" width="800" height="1200" loading="lazy" alt="KeyHandoff Safe Copy listening for one copy, with a countdown ring around Ctrl and C" /></figure>
        <figure class="shot front-shot"><img src="/shots/home.png" width="800" height="1200" loading="lazy" alt="The KeyHandoff vault showing 3 keys, sealed: Dialpad, Stripe and OpenAI" /></figure>
        <div class="typer" aria-hidden="true">
          <span class="typer-label"><Icon name="key" size={14} />Typing Stripe (billing)</span>
          <span class="typer-field"><span class="dots"></span><i class="caret"></i></span>
        </div>
      </div>
    </section>

    <section class="wrap" id="code">
      <div class="head rv">
        <span class="eyebrow"><Icon name="terminal" />Your code <Status kind="building" /></span>
        <h2>A search finds a pointer. Not a key.</h2>
        <p class="sub">The file stays and your code stays. The secret leaves, and your programs ask the app for it over a private pipe.</p>
      </div>
      <div class="code-grid rv">
        <div class="diff">
          <div class="diff-pane bad">
            <span class="diff-label"><Icon name="flame" size={14} />.env today</span>
            <pre><code>DIALPAD_API_KEY=<mark>dp_7Qm2vX9kLw4Tz</mark>
OPENAI_API_KEY=<mark>sk-proj-Xk29fLmQ7vRb</mark></code></pre>
          </div>
          <div class="diff-pane good">
            <span class="diff-label"><Icon name="shield" size={14} />.env with KeyHandoff</span>
            <pre><code>DIALPAD_API_KEY=<mark>handoff:Dialpad</mark>
OPENAI_API_KEY=<mark>handoff:OpenAI</mark></code></pre>
          </div>
        </div>
        <div class="prompt">
          <div class="prompt-top"><span class="tile sm"><Logo height={21} /></span><b>KeyHandoff</b><span>A program is asking</span></div>
          <p class="prompt-q"><code>report.py</code> wants the <b>Dialpad</b> key</p>
          <p class="prompt-where"><Icon name="file" size={14} />~/work/report-bot</p>
          <div class="prompt-btns"><span class="btn secondary small">Just this once</span><span class="btn primary small">Always allow</span></div>
        </div>
      </div>
      <div class="flow rv">
        <div class="flow-track" aria-hidden="true"><i class="ask"></i><i class="back"></i></div>
        <div class="flow-node n1"><span class="node-ico"><Icon name="terminal" size={22} /></span><h3>Your program starts</h3><p>It finds a pointer where a key used to be.</p></div>
        <div class="flow-node n2"><span class="node-ico"><Icon name="lock" size={22} /></span><h3>It asks privately</h3><p>Over a local pipe. Nothing leaves your machine.</p></div>
        <div class="flow-node n3"><span class="node-ico"><Icon name="shield" size={22} /></span><h3>KeyHandoff checks</h3><p>Which program, which folder? You approve it once.</p></div>
        <div class="flow-node n4"><span class="node-ico"><Icon name="key" size={22} /></span><h3>The key arrives</h3><p>Straight into that program's memory.</p></div>
      </div>
    </section>

    <section class="wrap" id="team">
      <div class="head rv">
        <span class="eyebrow"><Icon name="users" />Your team <Status kind="now" /></span>
        <h2>Need a key from someone? Stop asking them to paste it.</h2>
        <p class="sub">The chat only ever carries a sealed file.</p>
      </div>
      <div class="screens rv">
        {TEAM_SCREENS.map((s, i) => (
          <figure class="screen" style={`--i:${i}`}>
            <div class="shot"><img src={s.src} width="800" height="1200" loading="lazy" alt={s.alt} /></div>
            <figcaption>
              <span class="who">{s.who}'s computer</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="wire rv" aria-hidden="true">
        <span class="wire-end"><Icon name="user" size={18} />Ann</span>
        <span class="wire-line">
          <span class="wire-file up"><Icon name="file" size={14} />Key request from Ann.handoff</span>
          <span class="wire-file down"><Icon name="lock" size={14} />Key for Ann.handoff</span>
        </span>
        <span class="wire-end"><Icon name="user" size={18} />Ben</span>
      </div>
      <p class="wire-note rv"><Icon name="chat" />Slack, Teams, email, whatever you already use. No links, nothing to sign up for.</p>
    </section>

    <section class="wrap" id="built-in">
      <div class="head center rv">
        <span class="eyebrow"><Icon name="shield" />Built in, everywhere</span>
        <h2>Calm on the surface. Serious underneath.</h2>
      </div>
      <div class="bento">
        {BUILT_IN.map((b, i) => (
          <div class="cell rv" style={`--d:${i * 60}ms`}>
            <span class="f-ico"><Icon name={b.icon} size={18} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap" id="roadmap">
      <div class="head rv">
        <span class="eyebrow"><Icon name="clock" />Where it's going</span>
        <h2>Your boss gives you a key in a few clicks. Your code and your AI use it. Nobody ever sees it.</h2>
      </div>
      <div class="road rv">
        <div class="road-col on">
          <Status kind="now" label="Works today" />
          <ul>
            <li><Icon name="check" />Requests and sealed replies between two people</li>
