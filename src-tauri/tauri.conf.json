{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyHandoff",
  "identifier": "dev.junovhs.keyhandoff",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyHandoff",
        "width": 400,
        "height": 600,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 560,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "handoff"
        ],
        "name": "KeyHandoff file",
        "description": "A KeyHandoff key request or sealed key",
        "role": "Viewer",
        "mimeType": "application/x-handoff"
      }
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "linux/keyhandoff.desktop",
        "files": {
          "/usr/share/mime/packages/keyhandoff.xml": "linux/keyhandoff-mime.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRDRCQzkzQzRFNDI5NUEKUldSYUtlVEVrN3pVM09LSEV0U0VNTGlyL25kQTdTUjE2RFRLZ1ZENHlTUUhzc2lOWDdqMmVVZFUK",
      "endpoints": [
        "https://github.com/junovhs/keyhandoff/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
